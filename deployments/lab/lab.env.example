# Copy this file to lab.env. Never commit lab.env.

# Absolute path to an official Windows 11 Arm64 ISO.
WINDOWS_ISO=""

# Optional override. The default is the workspace's work/prooflayer-lab folder.
PROOFLAYER_LAB_STATE_DIR=""

LAB_MEMORY_MB="8192"
LAB_CPUS="4"
LAB_DISK_SIZE="80G"

# offline | isolated | nat
LAB_NETWORK_MODE="isolated"

# NAT is refused unless this value is exactly YES.
ALLOW_INTERNET="NO"

