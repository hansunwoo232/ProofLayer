{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prooflayer.dev/v1/scenario.schema.json",
  "title": "ProofLayer Scenario Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_version",
    "name",
    "platform",
    "action",
    "execution",
    "risk_level",
    "timeout_seconds",
    "cleanup_required",
    "cleanup",
    "expected_telemetry"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "platform": { "enum": ["windows"] },
    "attack_technique": {
      "type": "string",
      "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$"
    },
    "action": {
      "enum": [
        "emit_process_marker",
        "create_registry_canary",
        "create_scheduled_task_canary",
        "create_local_user_canary",
        "create_service_canary",
        "query_dns_canary"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "network_access"],
      "properties": {
        "handler": {
          "enum": [
            "builtin.emit_process_marker",
            "builtin.create_registry_canary",
            "builtin.create_scheduled_task_canary",
            "builtin.create_local_user_canary",
            "builtin.create_service_canary",
            "builtin.query_dns_canary"
          ]
        },
        "network_access": { "enum": ["none", "dns_only"] }
      }
    },
    "risk_level": { "enum": ["low", "moderate"] },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "cleanup_required": { "const": true },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "timeout_seconds", "max_attempts", "verify_absence"],
      "properties": {
        "strategy": {
          "enum": [
            "verify_no_artifacts",
            "remove_registry_value",
            "delete_scheduled_task",
            "delete_local_user",
            "delete_service"
          ]
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "verify_absence": { "const": true }
      }
    },
    "parameter_schema": {
      "type": "object",
      "description": "A restricted schema evaluated by the Runner.",
      "additionalProperties": false
    },
    "expected_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "event_ids", "required_fields"],
      "properties": {
        "provider": { "enum": ["windows_event_log", "sysmon"] },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "emit_process_marker" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.emit_process_marker" },
              "network_access": { "const": "none" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "verify_no_artifacts" } } }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "create_registry_canary" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.create_registry_canary" },
              "network_access": { "const": "none" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "remove_registry_value" } } }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "create_scheduled_task_canary" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.create_scheduled_task_canary" },
              "network_access": { "const": "none" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "delete_scheduled_task" } } }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "create_local_user_canary" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.create_local_user_canary" },
              "network_access": { "const": "none" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "delete_local_user" } } }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "create_service_canary" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.create_service_canary" },
              "network_access": { "const": "none" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "delete_service" } } }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "query_dns_canary" } } },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "handler": { "const": "builtin.query_dns_canary" },
              "network_access": { "const": "dns_only" }
            }
          },
          "cleanup": { "properties": { "strategy": { "const": "verify_no_artifacts" } } }
        }
      }
    }
  ]
}
