{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prooflayer.dev/v1/test-job-receipt.schema.json",
  "title": "ProofLayer Test Job Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "correlation_id", "status", "replayed"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "format": "uuid" },
    "correlation_id": {
      "type": "string",
      "pattern": "^PL-[A-F0-9]{32}$"
    },
    "status": { "const": "queued" },
    "replayed": { "type": "boolean" }
  }
}
