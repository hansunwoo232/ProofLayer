{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prooflayer.dev/v1/test-run.schema.json",
  "title": "ProofLayer Test Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "job_id",
    "correlation_id",
    "environment_id",
    "host",
    "scenario",
    "overall_status",
    "started_at",
    "stages"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "correlation_id": {
      "type": "string",
      "pattern": "^PL-[A-F0-9]{32}$"
    },
    "environment_id": { "type": "string", "format": "uuid" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "display_name", "platform"],
      "properties": {
        "host_id": { "type": "string", "format": "uuid" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "platform": { "const": "windows" },
        "runner_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "scenario_version", "name"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "scenario_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "overall_status": {
      "enum": ["pending", "running", "passed", "failed", "degraded", "cancelled", "expired"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "root_cause": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "summary"],
      "properties": {
        "category": {
          "enum": [
            "execution_error",
            "missing_endpoint_telemetry",
            "siem_ingestion_timeout",
            "missing_required_field",
            "detection_not_triggered",
            "alert_not_created",
            "cleanup_failed",
            "observer_error",
            "unknown"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "field": { "type": "string", "maxLength": 120 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "execution" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "endpoint_telemetry" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "siem_ingestion" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "field_validation" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "detection" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "alert" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/stageResult" },
            { "properties": { "stage": { "const": "cleanup" } } }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "required",
        "started_at",
        "completed_at",
        "latency_ms",
        "evidence",
        "error"
      ],
      "properties": {
        "stage": {
          "enum": [
            "execution",
            "endpoint_telemetry",
            "siem_ingestion",
            "field_validation",
            "detection",
            "alert",
            "cleanup"
          ]
        },
        "status": {
          "enum": ["pending", "running", "passed", "failed", "degraded", "not_tested"]
        },
        "required": { "type": "boolean" },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_count": { "type": "integer", "minimum": 0 },
            "event_id": { "type": "integer", "minimum": 1 },
            "record_id": { "type": "integer", "minimum": 1 },
            "index": { "type": "string", "maxLength": 120 },
            "sourcetype": { "type": "string", "maxLength": 120 },
            "matched_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "missing_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "reference_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "message": { "type": "string", "maxLength": 500 },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
