{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prooflayer.dev/v1/test-job.schema.json",
  "title": "ProofLayer Test Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "correlation_id",
    "environment_id",
    "host_id",
    "scenario_id",
    "scenario_version",
    "requested_by",
    "requested_at",
    "expires_at",
    "nonce",
    "parameters",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "format": "uuid" },
    "correlation_id": {
      "type": "string",
      "pattern": "^PL-[A-F0-9]{32}$"
    },
    "environment_id": { "type": "string", "format": "uuid" },
    "host_id": { "type": "string", "format": "uuid" },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requested_by": { "type": "string", "format": "uuid" },
    "requested_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 10,
      "additionalProperties": {
        "type": ["string", "integer", "boolean"]
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{80,120}$"
        }
      }
    }
  }
}
