{
  "schema_version": "1.0",
  "scenario_id": "windows-registry-run-key-canary",
  "scenario_version": "0.1.0",
  "name": "Windows Registry Run Key Canary",
  "description": "Creates and immediately removes one correlation-bound HKCU Run value.",
  "platform": "windows",
  "attack_technique": "T1547.001",
  "action": "create_registry_canary",
  "execution": {
    "handler": "builtin.create_registry_canary",
    "network_access": "none"
  },
  "risk_level": "moderate",
  "timeout_seconds": 30,
  "cleanup_required": true,
  "cleanup": {
    "strategy": "remove_registry_value",
    "timeout_seconds": 10,
    "max_attempts": 1,
    "verify_absence": true
  },
  "parameter_schema": {},
  "expected_telemetry": {
    "provider": "sysmon",
    "event_ids": [13],
    "required_fields": [
      "registry.path",
      "registry.value",
      "host.name",
      "user.name"
    ]
  }
}
