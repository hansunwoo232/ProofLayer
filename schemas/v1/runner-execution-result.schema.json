{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prooflayer.dev/v1/runner-execution-result.schema.json",
  "title": "ProofLayer Runner Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "correlation_id",
    "scenario_id",
    "scenario_version",
    "started_at",
    "completed_at",
    "latency_ms",
    "cleanup_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["passed", "failed"] },
    "correlation_id": {
      "type": "string",
      "pattern": "^PL-[A-F0-9]{32}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cleanup_status": { "enum": ["passed", "failed"] },
    "error_code": {
      "enum": [
        "invalid_identity",
        "invalid_request",
        "audit_write_failed",
        "unsupported_platform",
        "execution_timeout",
        "execution_failed",
        "cleanup_failed",
        "artifact_remaining"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": { "not": { "required": ["error_code"] } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["error_code"] }
    }
  ]
}
